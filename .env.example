# Vite (public — safe in the browser bundle)
VITE_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Optional: gate the public marketing site for anonymous visitors (redirects to /waitlist).
# Default unset/false = normal behaviour.
# VITE_PUBLIC_COMING_SOON=true

# Auth allowlist (default in code: jaedanhug@gmail.com only). Override with comma-separated emails:
# VITE_AUTH_ALLOWLIST_EMAILS=you@example.com,other@example.com
# To open the app to everyone again (no allowlist):
# VITE_AUTH_ALLOWLIST_OFF=true

# Stripe — set in Supabase Dashboard → Edge Functions → Secrets (never commit real keys):
# STRIPE_SECRET_KEY=sk_live_... or sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (Dashboard → Developers → Webhooks → Signing secret; required for stripe-webhook)
# SUPABASE_ANON_KEY=eyJ...           (required on stripe-success for JWT → getUser resolution)
#
# Alerts / logging (optional; never commit real values):
# DB_WEBHOOK_SECRET=...              (db-webhook-receiver X-Webhook-Secret)
# ALERT_WEBHOOK_FORWARD_URL=...      (optional Slack/Discord forward from db-webhook-receiver — minimal JSON only)
# REQUEST_LOG_USER_SALT=...          (salts user_h in Edge request log lines)
# SCAN_FAILURE_ALERT_URL=...       (optional HTTP POST when scan failure streak ≥ threshold)
# SCAN_FAILURE_ALERT_SECRET=...    (optional X-Webhook-Secret for SCAN_FAILURE_ALERT_URL)
# SCAN_FAILURE_ALERT_THRESHOLD=5
# SCAN_FAILURE_WINDOW_MINUTES=15
#
# Checkout success/cancel URLs are passed from the frontend (e.g. /scan?payment_success=1&... and /pricing).
# Stripe webhook endpoint URL: https://<project-ref>.supabase.co/functions/v1/stripe-webhook
#
# Browser CORS (Edge secret — comma-separated origins allowed to call SPA-backed functions):
# EDGE_EXTRA_ALLOWED_ORIGINS=https://your-app.readdy.ai,https://preview.example.com
